# Where telemetry comes from: "fixture" or "gcp"
source=fixture

# Path to sample data (used when source is "fixture")
fixture_path=fixtures/events.jsonl

# Required when source is "gcp"
gcp_project_id=

# Cloud Run service name to read (used when source is "gcp")
api_service_name=football-api

# Cache lifetime for source queries, in seconds (0 to 600)
cache_ttl_seconds=60

# Default time window for pages, in hours (1 to 720)
default_window_hours=24