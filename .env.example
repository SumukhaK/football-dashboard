# Where telemetry comes from: "fixture", "local" or "gcp"
source=fixture

# Folder with the four sample files (used when source is "fixture").
# A relative path is resolved against the repository root.
fixture_dir=fixtures

# The backend's JSON log file (used when source is "local"), written by running
# the backend with LOG_FORMAT=json and saving its output. Give the full path to
# the file. Only its last local_log_max_bytes are read, and a source="local"
# run must set this.
local_log_path=
# How much of the end of that file to read, in bytes (1 MB to 1 GB).
local_log_max_bytes=50000000

# Required when source is "gcp"
gcp_project_id=

# Cloud Run service name to read (used when source is "gcp")
api_service_name=football-api

# Cache lifetime for source queries, in seconds (0 to 600)
cache_ttl_seconds=60

# Default time window for pages, in hours. Must be one the picker offers:
# 1, 6, 24 or 168.
default_window_hours=24

# Optional display-only conversion of reported USD provider costs to INR.
# Supply both an operator-chosen positive finite rate and its ISO as-of date.
# No rate is assumed or fetched. Missing either shows "INR conversion unavailable".
# Placeholders only; do not uncomment until replacing both values.
# inr_per_usd=<INR per USD>
# inr_per_usd_as_of=<YYYY-MM-DD>

# How far back a component tile looks for its last load / refresh / freshness
# reading, in hours, so a short window is not all grey.
tile_lookback_hours=168

# Cloud Logging page size when source is "gcp" (1 to 1000)
gcp_page_size=1000

# Data-freshness tile thresholds, in hours: green below warn, amber up to
# error, red above.
freshness_warn_hours=36
freshness_error_hours=72

# platform_patterns maps Cloud Run system log text to platform events.
# The defaults live in app/config.py; override only after checking real logs,
# as JSON, for example:
# platform_patterns=[["Memory limit of","out_of_memory"]]

# The opt-in invite page, the one place the console writes to Google Cloud
# (one Firestore document per invite). Run it locally as the owner after
# `gcloud auth application-default login`. Uses gcp_project_id.
invites_enabled=false
invite_collection_prefix=staging_
invite_lifetime_days=7

# The console's own sign-in (see guide/D9-owner-login.md).
#
# "google" (the default) restricts the console to one verified Google account,
# and the console refuses to start until every setting below it is present, so a
# deployment can never quietly serve without its gate. "fixture" is the explicit
# loopback demonstration mode: it is refused for a real source, an enabled invite
# page or a hosted revision (Cloud Run sets K_REVISION).
auth_mode=google

# The one Google account the console serves, lower case.
owner_email=sumukh.aithal@gmail.com

# A Google *Web application* OAuth client - not an API key, not an Android client
# and not a service account - and its secret. The secret is a SecretStr and is
# never printed. Real values live in Secret Manager.
#
# The six Google assignments are commented out on purpose: this file is loaded
# explicitly (`uv run --env-file .env`), so an empty assignment is a *provided*
# value and would fail validation instead of staying unset. Uncomment all six
# for a Google profile; a fixture profile leaves them commented out.
# google_client_id=
# google_client_secret=

# The canonical origin, and the callback derived from it. HTTPS when hosted;
# http is accepted only for 127.0.0.1 development.
# auth_public_origin=
# auth_callback_url=

# Two independent random secrets of at least 32 bytes each, with no default and
# no fallback key. Generate each one privately, for example with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`, and never
# commit a real value.
# session_signing_key=
# oauth_signing_key=

# An hour of console session and five minutes of pending sign-in, at most.
session_max_age_seconds=3600
oauth_transaction_max_age_seconds=300
