# Copy to deploy/verification/<revision>.env (gitignored) after checking the
# candidate privately; see deploy/README.md, "Verify a candidate".
#
# promote.sh and rollback.sh read this file as data and never run it. Each
# check needs a short note of what you saw; a bare "true" or "yes" is refused.
# The scripts cannot check that the notes are true: never record a check you
# did not make. No passwords, tokens, codes or cookie values belong here.

# The revision and image digest deploy.sh printed.
REVISION=football-dashboard-<build-id>
DIGEST=sha256:<digest>

# A signed-out browser got the sign-in page on full pages.
SIGNED_OUT_DENIED=
# HTMX partials and detail routes returned a denial with no data.
PARTIAL_DENIED=
# The owner signed in through the tag URL and saw the console.
OWNER_ALLOWED=
# A second Google account was refused before any data was read.
NON_OWNER_DENIED=
# D9 privacy checks: no code, token, verifier or email in logs or rendered errors.
PRIVACY_CHECKED=
# Who checked, and when (UTC).
VERIFIED_BY=
VERIFIED_AT=
