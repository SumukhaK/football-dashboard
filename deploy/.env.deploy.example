# Copy this file to deploy/.env.deploy (gitignored) and fill in the values.
# Never commit the real file: it names the project, region and owner.
#
# This file holds names and numbers, never a secret value. The Google client
# secret and the two signing keys are bound from Secret Manager by numeric
# version, so a deploy is repeatable and no credential is written to disk here.

# The Google Cloud project that runs the API and will run this console.
GCP_PROJECT_ID=your-project-id

# The region the API and the console run in.
REGION=your-region

# The Cloud Run service the console reads platform logs for.
# Staging is football-api-staging; production will be football-api.
API_SERVICE_NAME=football-api

# The Cloud Run service name for the console itself.
SERVICE_NAME=football-dashboard

# The Artifact Registry repository that holds the console images.
REPOSITORY=football-dashboard

# How browsers reach the console.
#   private  (default) Cloud Run IAM is the edge: you reach it with
#            `gcloud run services proxy`, and the owner sign-in sits inside.
#   app-auth open the public HTTP edge only because the application enforces
#            the owner's Google sign-in. deploy/promote.sh adds the
#            service-scoped allUsers binding after the verified revision takes
#            100% of traffic; deploy.sh and rollback.sh never open it. The
#            invoker IAM check stays enabled.
DASHBOARD_TRANSPORT=private

# The canonical https origin, with no path, query or fragment. The callback is
# derived from it as <origin>/auth/callback and must match the Web client.
AUTH_PUBLIC_ORIGIN=https://console.example

# The Web OAuth client id from Google Auth Platform (not a secret).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The one Google account allowed to sign in. Lower-case; no display name.
OWNER_EMAIL=owner@example.com

# Secret Manager names and the numeric versions to bind. Add a new version
# rather than overwriting one, so a rollback can still name what it ran with.
GOOGLE_CLIENT_SECRET_NAME=google-client-secret
GOOGLE_CLIENT_SECRET_VERSION=1
SESSION_SIGNING_KEY_NAME=session-signing-key
SESSION_SIGNING_KEY_VERSION=1
OAUTH_SIGNING_KEY_NAME=oauth-signing-key
OAUTH_SIGNING_KEY_VERSION=1

# The traffic tag on an unserved candidate. It is removed after promotion, so
# no tagged URL reaches an older revision.
CANDIDATE_TAG=candidate
