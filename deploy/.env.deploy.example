# Copy this file to deploy/.env.deploy (gitignored) and fill in the values.
# Never commit the real file: it names the project and region.

# The Google Cloud project that runs the API and will run this console.
GCP_PROJECT_ID=your-project-id

# The region the API and the console run in.
REGION=your-region

# The Cloud Run service the console reads platform logs for.
# Staging is football-api-staging; production will be football-api.
API_SERVICE_NAME=football-api

# The Cloud Run service name for the console itself.
SERVICE_NAME=football-dashboard

# The Artifact Registry repository that holds the console images.
REPOSITORY=football-dashboard
