    "api_version",
    "contract_version",
    "attributes"
  ],
  "components": [
    "prediction_model",
    "prediction_model_v1",
    "explanation",
    "assistant",
    "season_history",
    "season_outlook",
    "fixtures",
    "match_history",
    "goals_model"
